{
	"compilerOptions": {
		"esModuleInterop": true,
		"strict": true,
		"lib": ["ESNext", "DOM"],
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"outDir": "./dist",
		"rootDir": "./lib"
	},
	"include": ["lib/**/*.ts"],
	"exclude": ["node_modules", "dist", "docs", "lib/**/*.test.ts"]
}
