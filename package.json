{
	"name": "@19h47/checkbox",
	"version": "6.2.0",
	"description": "Custom checkbox element with accessibility in mind",
	"keywords": [
		"checkbox",
		"accessibility",
		"a11y",
		"ES6"
	],
	"homepage": "https://github.com/19h47/19h47-checkbox#readme",
	"bugs": {
		"url": "https://github.com/19h47/19h47-checkbox/issues"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/19h47/19h47-checkbox.git"
	},
	"license": "ISC",
	"author": "Jérémy Levron <jeremylevron@19h47.fr> (https://19h47.fr)",
	"type": "module",
	"files": [
		"dist"
	],
	"main": "./dist/checkbox.umd.cjs",
	"module": "./dist/checkbox.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/checkbox.js",
			"require": "./dist/checkbox.umd.cjs"
		}
	},
	"scripts": {
		"dev": "vite",
		"test": "vitest run",
		"build": "vite build && tsc && vite build --config vite.config.docs.js",
		"build:docs": "vite build --config vite.config.docs.js",
		"deploy": "pnpm login && pnpm run build && pnpm publish --access public --no-git-checks"
	},
	"devDependencies": {
		"@19h47/prettier-config": "^2.0.0",
		"happy-dom": "^20.10.6",
		"prettier": "^3.9.5",
		"typescript": "^7.0.2",
		"vite": "^8.1.4",
		"vitest": "^4.1.10"
	},
	"packageManager": "pnpm@10.12.1",
	"prettier": "@19h47/prettier-config"
}
